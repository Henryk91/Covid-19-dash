{
  "name": "covid-19-dash",
  "description": "Dashboard showing world covid 19 data",
  "version": "2.0.0",
  "author": "Henry K",
  "dependencies": {
    "axios": "^0.19.2",
    "d3": "^5.15.1",
    "gatsby": "^5.15.0",
    "gatsby-plugin-react-helmet": "^6.15.0",
    "gatsby-plugin-sass": "^6.15.0",
    "gatsby-remark-vega": "^0.2.6",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-remark": "^6.15.0",
    "gh-pages": "^2.2.0",
    "leaflet": "^1.9.4",
    "prop-types": "^15.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-leaflet": "^4.2.1",
    "react-vega": "^7.3.0",
    "rehype-react": "^5.0.1",
    "sass": "^1.72.0",
    "vega": "^5.25.0",
    "vega-lite": "^5.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^25.1.0",
    "babel-preset-gatsby": "^3.15.0",
    "core-js": "^3.46.0",
    "enzyme": "^3.11.0",
    "eslint": "^6.8.0",
    "eslint-config-zurgbot": "^0.0.6",
    "eslint-plugin-react": "^7.19.0",
    "eslint-plugin-react-hooks": "^2.5.0",
    "husky": "^4.2.3",
    "jest": "^25.1.0",
    "lint-staged": "^10.0.8",
    "prettier": "^1.19.1",
    "prettier-eslint": "^9.0.1",
    "prettier-eslint-cli": "^5.0.0"
  },
  "keywords": [
    "gatsby",
    "sass",
    "leaflet",
    "mapping",
    "maps"
  ],
  "license": "MIT",
  "scripts": {
    "build": "gatsby build --prefix-paths",
    "clean": "gatsby clean",
    "develop": "gatsby develop -p 3000",
    "format": "prettier-eslint --eslint-config-path ./config/eslint.config.js --write '**/*.js'",
    "lint": "eslint -c ./config/eslint.config.js . --ext .js",
    "start": "yarn develop",
    "serve": "gatsby serve",
    "test": "jest --config ./config/jest.config.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "deploy:github": "npm run build && node ./scripts/deploy-github"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.js": [
      "yarn format",
      "yarn lint"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Henryk91/Covid-19-dash"
  },
  "engines": {
    "node": ">=18"
  }
}
